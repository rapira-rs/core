{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "rapira: worker — fixtures/worker.php",
      "cargo": {
        "args": [
          "build",
          "--bin=rapira_core",
          "--package=rapira_core"
        ],
        "filter": {
          "name": "rapira_core",
          "kind": "bin"
        }
      },
      "args": [
        "--mode",
        "worker",
        "--threads",
        "1",
        "--script",
        "${workspaceFolder}/crates/integration_tests/fixtures/worker.php"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "sourceLanguages": [
        "rust"
      ],
      "env": {
        "LD_LIBRARY_PATH": "${env:HOME}/.local/php-zts/lib",
        "PHP_CONFIG": "${env:HOME}/.local/php-zts/bin/php-config"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "rapira: classic — fixtures/hello.php",
      "cargo": {
        "args": [
          "build",
          "--bin=rapira_core",
          "--package=rapira_core"
        ],
        "filter": {
          "name": "rapira_core",
          "kind": "bin"
        }
      },
      "args": [
        "--mode",
        "classic",
        "--script",
        "${workspaceFolder}/crates/integration_tests/fixtures/hello.php"
      ],
      "cwd": "${workspaceFolder}",
      "terminal": "integrated",
      "sourceLanguages": [
        "rust"
      ],
      "env": {
        "LD_LIBRARY_PATH": "${env:HOME}/.local/php-zts/lib",
        "PHP_CONFIG": "${env:HOME}/.local/php-zts/bin/php-config"
      }
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug tests -- ZTS",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "-p",
          "integration-tests"
        ],
        "env": {
          "PHP_CONFIG": "${env:HOME}/.local/php-zts/bin/php-config",
          "CARGO_TARGET_DIR": "${workspaceFolder}/target/zts"
        }
      },
      "args": [],
      "env": {
        "LD_LIBRARY_PATH": "${env:HOME}/.local/php-zts/lib"
      },
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug tests -- NTS",
      "cargo": {
        "args": [
          "test",
          "--no-run",
          "-p",
          "integration-tests"
        ],
        "env": {
          "PHP_CONFIG": "/usr/bin/php-config",
          "CARGO_TARGET_DIR": "${workspaceFolder}/target/nts",
          "RUSTFLAGS": "-L native=/usr/lib64"
        }
      },
      "args": [],
      "env": {
        "LD_LIBRARY_PATH": "/usr/lib64"
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
