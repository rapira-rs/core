{
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.runAutomatically": true,
    "c-cpp-flylint.language": "c",
    "c-cpp-flylint.run": "onSave",
    "c-cpp-flylint.clang.enable": false,
    "c-cpp-flylint.flexelint.enable": false,
    "c-cpp-flylint.lizard.enable": false,
    "c-cpp-flylint.flawfinder.enable": false,
    "c-cpp-flylint.pclintplus.enable": false,
    "c-cpp-flylint.cppcheck.enable": true,
    "c-cpp-flylint.cppcheck.standard": [
        "c17"
    ],
    "c-cpp-flylint.cppcheck.extraArgs": [
        "--enable=warning,style,performance,portability",
        "--inline-suppr"
    ],
    "c-cpp-flylint.cppcheck.defines": [
        "ZTS=1"
    ],
    "c-cpp-flylint.cppcheck.includePaths": [
        "${HOME}/.local/php-zts/include/php",
        "${HOME}/.local/php-zts/include/php/main",
        "${HOME}/.local/php-zts/include/php/TSRM",
        "${HOME}/.local/php-zts/include/php/Zend",
        "${HOME}/.local/php-zts/include/php/ext",
        "${HOME}/.local/php-zts/include/php/ext/date/lib"
    ],
    "c-cpp-flylint.cppcheck.suppressions": [
        "*:*php-zts/include*"
    ]
}
