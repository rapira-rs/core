{
    "C_Cpp.codeAnalysis.clangTidy.enabled": true,
    "C_Cpp.codeAnalysis.clangTidy.path": "/usr/bin/clang-tidy",
    "C_Cpp.codeAnalysis.runAutomatically": true,
    "c-cpp-flylint.language": "c",
    "c-cpp-flylint.run": "onSave",
    "c-cpp-flylint.clang.enable": false,
    "c-cpp-flylint.flexelint.enable": false,
    "c-cpp-flylint.lizard.enable": false,
    "c-cpp-flylint.flawfinder.enable": false,
    "c-cpp-flylint.pclintplus.enable": false,
    "c-cpp-flylint.cppcheck.enable": true,
    "c-cpp-flylint.cppcheck.executable": "/usr/bin/cppcheck",
    "c-cpp-flylint.cppcheck.standard": ["c17"],
    "c-cpp-flylint.cppcheck.extraArgs": ["--std=c23", "--enable=warning,style,performance,portability", "--inline-suppr"],
    "c-cpp-flylint.cppcheck.defines": ["ZTS=1"],
    "c-cpp-flylint.cppcheck.includePaths": [
        "/home/valery/.local/php-zts/include/php",
        "/home/valery/.local/php-zts/include/php/main",
        "/home/valery/.local/php-zts/include/php/TSRM",
        "/home/valery/.local/php-zts/include/php/Zend",
        "/home/valery/.local/php-zts/include/php/ext",
        "/home/valery/.local/php-zts/include/php/ext/date/lib"
    ],
    "c-cpp-flylint.cppcheck.suppressions": ["*:*php-zts/include*"]
}
