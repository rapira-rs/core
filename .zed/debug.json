[
	{
		"label": "rapira: serve worker - examples/worker.php",
		"adapter": "CodeLLDB",
		"request": "launch",
		"program": "$ZED_WORKTREE_ROOT/target/debug/rapira",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin=rapira", "--package=rapira_core"]
		},
		"args": [
			"serve",
			"--mode",
			"worker",
			"--processes",
			"1",
			"examples/worker.php"
		],
		"cwd": "$ZED_WORKTREE_ROOT",
		"env": {
			"DYLD_LIBRARY_PATH": "target/phplib",
			"LD_LIBRARY_PATH": "target/phplib",
			"RUST_LOG": "info"
		},
		"sourceLanguages": ["rust"]
	},
	{
		"label": "rapira: serve worker - follow fork child",
		"adapter": "CodeLLDB",
		"request": "launch",
		"program": "$ZED_WORKTREE_ROOT/target/debug/rapira",
		"build": {
			"command": "cargo",
			"args": ["build", "--bin=rapira", "--package=rapira_core"]
		},
		"args": [
			"serve",
			"--mode",
			"worker",
			"--processes",
			"1",
			"examples/worker.php"
		],
		"cwd": "$ZED_WORKTREE_ROOT",
		"env": {
			"DYLD_LIBRARY_PATH": "target/phplib",
			"LD_LIBRARY_PATH": "target/phplib",
			"RUST_LOG": "info"
		},
		"initCommands": ["settings set target.process.follow-fork-mode child"],
		"sourceLanguages": ["rust"]
	}
]
